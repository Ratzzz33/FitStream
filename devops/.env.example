# FitStream DevOps Environment Variables
# Скопируй в .env и заполни реальными значениями

# Gitea Runner
GITEA_RUNNER_TOKEN=your_runner_registration_token

# SonarQube Database
SONAR_DB_PASSWORD=strong_password_here

# Dependency-Track Database
DTRACK_DB_PASSWORD=strong_password_here

# DefectDojo
DOJO_DB_PASSWORD=strong_password_here
DOJO_SECRET_KEY=generate-with-openssl-rand-base64-32
DOJO_AES_KEY=generate-with-openssl-rand-base64-32
