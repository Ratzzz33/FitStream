# FitStream DevOps - GitHub Actions Runner Config
# Скопируй в .env и заполни

# ============================================
# GITHUB RUNNER (ОБЯЗАТЕЛЬНО)
# ============================================

# URL твоего репозитория
GITHUB_REPO_URL=https://github.com/YOUR_USERNAME/FitStream

# Personal Access Token с правами:
# - repo (для приватных репозиториев)
# - admin:org (если используешь org-level runner)
# Создать: https://github.com/settings/tokens
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx

# Имя раннера (отображается в GitHub)
RUNNER_NAME=fitstream-runner

# ============================================
# SONARQUBE (опционально)
# ============================================
SONAR_DB_PASSWORD=change_this_password

# ============================================
# DEPENDENCY-TRACK (опционально)
# ============================================
DTRACK_DB_PASSWORD=change_this_password

# ============================================
# DEFECTDOJO (опционально)
# ============================================
DOJO_DB_PASSWORD=change_this_password
DOJO_SECRET_KEY=generate-with-openssl-rand-base64-32
DOJO_AES_KEY=generate-with-openssl-rand-base64-32
